# Load locally with: node --env-file=.env backend/server.js
# Leave DATABASE_URL unset to use local SQLite.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# FRONTEND_ORIGINS=https://your-project.vercel.app
# RENDER_BACKEND_URL=https://your-api.onrender.com
# COOKIE_SECURE=1
